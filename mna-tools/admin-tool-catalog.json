  {
    "controller_only": false,
    "endpoint": "/admin/space-export",
    "input_schema": {
      "$defs": {
        "BrowseArgs": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 100,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "offset": {
              "default": 0,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "sort": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Sort"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        "Direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string"
        },
        "Format": {
          "enum": [
            "xlsx"
          ],
          "type": "string"
        },
        "IsccArgs": {
          "additionalProperties": false,
          "properties": {
            "count": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query",
            "count"
          ],
          "type": "object"
        },
        "LexicalArgs": {
          "additionalProperties": false,
          "properties": {
            "expression": {
              "type": [
                "string",
                "null"
              ]
            },
            "keywords": {
              "default": [],
              "items": {
                "$ref": "#/$defs/SpaceKeyword"
              },
              "type": "array"
            },
            "limit": {
              "default": 100,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "offset": {
              "default": 0,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "Match": {
          "enum": [
            "stem",
            "exact"
          ],
          "type": "string"
        },
        "SearchArgs": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsccArgs"
            },
            {
              "$ref": "#/$defs/SemanticArgs"
            },
            {
              "$ref": "#/$defs/BrowseArgs"
            },
            {
              "$ref": "#/$defs/LexicalArgs"
            }
          ]
        },
        "SemanticArgs": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 100,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "min_score": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "offset": {
              "default": 0,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "Sort": {
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string"
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            }
          },
          "required": [
            "column",
            "direction"
          ],
          "type": "object"
        },
        "SpaceKeyword": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "match": {
              "$ref": "#/$defs/Match",
              "default": "stem"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allow_simulated": {
          "default": false,
          "type": "boolean"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "search": {
          "$ref": "#/$defs/SearchArgs"
        }
      },
      "required": [
        "search",
        "format"
      ],
      "title": "ExportArgs",
      "type": "object"
    },
    "name": "space_export"
  },
